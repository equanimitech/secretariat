{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secretariat",
  "version": "0.2.0",
  "identifier": "tech.equanimi.secretariat",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Secretariat",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rafa Ballestiero",
    "category": "Productivity",
    "shortDescription": "Cryptographically attested AI-mediated correspondence",
    "longDescription": "Secretariat lets a principal stamp AI-drafted documents with biometric-attested signatures, embed the attestation in the file, and share via any transport. Designed around Autonomous Enterprise principles: humans govern, machines operate.",
    "copyright": "Copyright © 2026 Rafa Ballestiero. All rights reserved.",
    "macOS": {
      "signingIdentity": "Developer ID Application: Rafael Toletti Ballestiero (BGCMNT55ZN)",
      "providerShortName": "BGCMNT55ZN",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/equanimitech/secretariat/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMkFFMjM5ODY4MTgwMjkKUldRcGdJR0dPZUlxZmw4NUFwRitzcytvbGZhV1VyOHN0Y2ltdjFRZURRNXpXMnl2T1N3Y0kzTTQK"
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["secretariat"]
      }
    }
  }
}
